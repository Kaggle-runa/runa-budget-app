generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/sqlite"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Project {
  id           String        @id @default(cuid())
  title        String
  status       String        @default("planned")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  events       Event[]
  ideas        Idea[]
}

model Transaction {
  id        String   @id @default(cuid())
  date      DateTime
  type      String
  amount    Int
  category  String
  title     String
  memo      String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@index([category])
}

model Event {
  id             String        @id @default(cuid())
  title          String
  startAt        DateTime
  endAt          DateTime
  allDay         Boolean       @default(false)
  kind           String        @default("other")
  body           String?
  linkUrl        String?
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id])
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([startAt])
  @@index([endAt])
}

model Idea {
  id          String   @id @default(cuid())
  displayName String
  title       String
  body        String
  status      String   @default("submitted")
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  category    String   @default("news")
  publishedAt DateTime
  coverUrl    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      Event[]

  @@index([publishedAt])
  @@index([published])
}

model ComicStrip {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
}
