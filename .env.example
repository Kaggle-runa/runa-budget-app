# ローカルでダミーデータを見るとき true。Supabase の URL はそのままでよい
# true にしたら npm run db:sqlite のあと npm run dev
USE_LOCAL_SQLITE="false"

# Supabase Postgres（本番 / 実データを見るとき）
# Project Settings > Database（または Connect）からコピーする
#
# DATABASE_URL = Transaction pooler（ポート 6543）
# DIRECT_URL   = Session pooler（ポート 5432、ホストは *.pooler.supabase.com）
#               db.xxxx.supabase.co は Render から届かないので使わない
# パスワードに @ # % などがあるときは URL エンコードする

DATABASE_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

ADMIN_PASSWORD="change-me"
ADMIN_SECRET="change-me-to-a-long-random-string"

# お知らせ画像のアップロード（Storage）。Project Settings > API
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="service_role の秘密鍵"

# 問い合わせボタンの飛び先。空なら /contact で準備中と出す
# GOOGLE_FORM_URL="https://docs.google.com/forms/d/e/xxxx/viewform"
